# nostos-api configuration. Names only: real values go in the secret store
# (kit secrets) or in Coolify's environment settings, never in git.

# PostgreSQL 16+ with the PostGIS extension available.
DATABASE_URL=postgres://nostos:change-me@localhost:5432/nostos_dev

# Bearer token for every route except /health and /media. At least 32 chars.
NOSTOS_OWNER_TOKEN=replace-with-a-long-random-token-0000000000

NOSTOS_BIND=0.0.0.0:8080
# Absolute URL clients use to reach this API.
NOSTOS_PUBLIC_URL=http://localhost:8080
NOSTOS_WORKERS=2

# Storage: "local" (development) or "s3" (Cloudflare R2 in production).
NOSTOS_STORAGE=local
NOSTOS_STORAGE_DIR=./data/media

# With NOSTOS_STORAGE=s3:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Originals (full GPS) go to a private bucket with no public domain;
# thumbnails and previews to the media bucket served on NOSTOS_MEDIA_URL.
# S3_BUCKET_ORIGINALS=nostos-originals
# S3_BUCKET_MEDIA=nostos-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Public base URL of thumbnails and previews (R2 custom domain).
# NOSTOS_MEDIA_URL=https://media.example.com
