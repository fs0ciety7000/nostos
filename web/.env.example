# nostos-web configuration. Names and placeholder values only.

# nostos-api, reached from the web server (never from the browser).
NOSTOS_API_URL=http://127.0.0.1:8080

# Basemap PMTiles. Production: the extract on R2 (see scripts/make-basemap.sh).
# Unset: the browser reads /basemap.pmtiles, relayed from BASEMAP_UPSTREAM.
PUBLIC_BASEMAP_URL=https://nostos-media.fs0ciety.org/tiles/nostos-basemap.pmtiles
# Development only: relay the Protomaps daily planet through the web server.
# BASEMAP_UPSTREAM=https://build.protomaps.com/20261104.pmtiles

# Map label fonts (glyph PBFs).
PUBLIC_GLYPHS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf

# adapter-node: public URL of the site, required behind a proxy.
ORIGIN=https://nostos.example.com
